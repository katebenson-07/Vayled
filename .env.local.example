NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — real email sending (Resend). Without these, template sends and
# Dashboard reminders fall back to opening your own email app (mailto).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@vayled.com
